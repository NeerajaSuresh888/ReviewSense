pythonimport pandas as pd
import json
from tqdm import tqdm

def load_amazon_reviews(filepath, n_reviews=50000):
    """
    Load Amazon reviews from JSONL file.
    
    Args:
        filepath: Path to .jsonl file
        n_reviews: Number of reviews to load (default 50K)
    
    Returns:
        DataFrame with reviews
    """
    reviews = []
    
    with open(filepath, 'r', encoding='utf-8') as f:
        for i, line in enumerate(tqdm(f, desc="Loading reviews")):
            if i >= n_reviews:
                break
            try:
                review = json.loads(line)
                reviews.append(review)
            except json.JSONDecodeError:
                continue
    
    df = pd.DataFrame(reviews)
    print(f"Loaded {len(df)} reviews")
    print(f"Columns: {df.columns.tolist()}")
    
    return df

# Execute
if __name__ == "__main__":
    df = load_amazon_reviews('data/raw/Electronics.jsonl', n_reviews=50000)
    
    # Save to CSV for faster loading later
