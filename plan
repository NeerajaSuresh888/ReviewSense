import pandas as pd
import numpy as np
from datetime import datetime

class MetadataFeatureExtractor:
    def extract(self, df):
        """Extract metadata features"""
        features = pd.DataFrame()
        
        # 1. Review length features
        features['review_char_length'] = df['text'].str.len()
        features['review_word_count'] = df['text'].str.split().str.len()
        features['avg_word_length'] = features['review_char_length'] / features['review_word_count']
        
        # 2. Verified purchase
        if 'verified_purchase' in df.columns:
            features['is_verified'] = df['verified_purchase'].astype(int)
        else:
            features['is_verified'] = 1  # Assume verified if not specified
        
        # 3. Helpfulness features
        if 'helpful_vote' in df.columns:
            features['helpful_votes'] = df['helpful_vote'].fillna(0)
        else:
            features['helpful_votes'] = 0
        
        # 4. Rating features
        features['rating'] = df['rating']
        features['is_positive'] = (df['rating'] >= 4).astype(int)
        features['is_negative'] = (df['rating'] <= 2).astype(int)
        features['is_extreme'] = ((df['rating'] == 1) | (df['rating'] == 5)).astype(int)
        
        # 5. Review age (if timestamp available)
        if 'timestamp' in df.columns:
            df['timestamp'] = pd.to_datetime(df['timestamp'], unit='s', errors='coerce')
            reference_date = df['timestamp'].max()
            features['days_since_review'] = (reference_date - df['timestamp']).dt.days
        else:
            features['days_since_review'] = 0
        
        # 6. Text complexity features
        features['exclamation_count'] = df['text'].str.count('!')
        features['question_count'] = df['text'].str.count('\?')
        features['uppercase_ratio'] = df['text'].apply(lambda x: sum(1 for c in x if c.isupper()) / len(x) if len(x) > 0 else 0)
        features['punctuation_ratio'] = df['text'].apply(lambda x: sum(1 for c in x if c in '.,!?;:') / len(x) if len(x) > 0 else 0)
        
        # 7. Specific keyword flags (for return intent)
        return_keywords = ['return', 'refund', 'send back', 'broke', 'broken', 'stopped working', 
                          'defective', 'waste', 'terrible', 'worst', 'horrible', 'useless']
        features['has_return_keywords'] = df['text'].str.lower().apply(
            lambda x: int(any(keyword in x for keyword in return_keywords))
        )
        
        # 8. Temporal degradation keywords
        temporal_keywords = ['after', 'stopped', 'no longer', 'used to', 'initially', 'at first']
        features['has_temporal_keywords'] = df['text'].str.lower().apply(
            lambda x: int(any(keyword in x for keyword in temporal_keywords))
        )
        
        # 9. Rating-text mismatch (will compute after sentiment)
        # Placeholder for now
        features['rating_normalized'] = (df['rating'] - 1) / 4  # Normalize to 0-1
        
        return features

