import pandas as pd
import numpy as np
from scipy.sparse import load_npz, hstack, csr_matrix

def combine_features(split='train'):
    """Combine all features for a data split"""
    
    # 1. Load TF-IDF (sparse)
    tfidf = load_npz(f'data/processed/{split}_tfidf.npz')
    print(f"TF-IDF shape: {tfidf.shape}")
    
    # 2. Load sentiment features (dense)
    sentiment = pd.read_csv(f'data/processed/{split}_sentiment.csv')
    print(f"Sentiment shape: {sentiment.shape}")
    
    # 3. Load metadata features (dense)
    metadata = pd.read_csv(f'data/processed/{split}_metadata.csv')
    print(f"Metadata shape: {metadata.shape}")
    
    # 4. Combine sentiment + metadata (dense)
    dense_features = pd.concat([sentiment, metadata], axis=1)
    
    # 5. Convert dense to sparse for concatenation
    dense_sparse = csr_matrix(dense_features.values)
    
    # 6. Horizontally stack all features
    combined = hstack([tfidf, dense_sparse])
    
    print(f"Combined shape: {combined.shape}")
    
    return combined, dense_features.columns.tolist()

if __name__ == "__main__":
    # Combine features for all splits
    train_features, feature_names = combine_features('train')
    val_features, _ = combine_features('val')
    test_features, _ = combine_features('test')
    
    # Save combined features
    from scipy.sparse import save_npz
    save_npz('data/processed/train_features.npz', train_features)
    save_npz('data/processed/val_features.npz', val_features)
    save_npz('data/processed/test_features.npz', test_features)
    
    # Save feature names
    import json
