import pandas as pd
import random

def sample_for_labeling(df, n=300):
    """
    Sample reviews for manual labeling.
    Stratified sampling: mix of positive, neutral, negative.
    """
    # Stratified sampling
    positive = df[df['rating'] >= 4].sample(100)
    neutral = df[df['rating'] == 3].sample(50)
    negative = df[df['rating'] <= 2].sample(150)  # More negatives likely to have return intent
    
    sample_df = pd.concat([positive, neutral, negative])
    sample_df = sample_df.sample(frac=1).reset_index(drop=True)  # Shuffle
    
    # Add labeling column
    sample_df['return_intent'] = None
    sample_df['labeler_notes'] = ''
    
    return sample_df

def label_reviews_cli(df):
    """
    Command-line interface for labeling reviews.
    """
    print("=" * 80)
    print("RETURN INTENT LABELING")
    print("=" * 80)
    print("Instructions:")
    print("  0 = No return intent")
    print("  1 = Return intent (customer likely to return/refund)")
    print("  s = Skip")
    print("  q = Quit and save")
    print("=" * 80)
    
    for idx, row in df.iterrows():
        if pd.notna(row['return_intent']):
            continue  # Already labeled
        
        print(f"\n[{idx+1}/{len(df)}]")
        print(f"Rating: {row['rating']}★")
        print(f"Text: {row['text'][:500]}...")  # Show first 500 chars
        print()
        
        while True:
            label = input("Label (0/1/s/q): ").strip().lower()
            
            if label == 'q':
                return df
            elif label == 's':
                break
            elif label in ['0', '1']:
                df.at[idx, 'return_intent'] = int(label)
                notes = input("Notes (optional): ").strip()
                if notes:
                    df.at[idx, 'labeler_notes'] = notes
                break
            else:
                print("Invalid input. Use 0, 1, s, or q.")
    
    return df

if __name__ == "__main__":
    df = pd.read_csv('data/processed/reviews_preprocessed.csv')
    
    # Check if labeled data already exists
    try:
        labeled_df = pd.read_csv('data/processed/labeled_reviews.csv')
        print(f"Found existing labeled data: {labeled_df['return_intent'].notna().sum()} labels")
        sample_df = labeled_df
    except FileNotFoundError:
        # Sample new data
        sample_df = sample_for_labeling(df, n=300)
    
    # Start labeling
    labeled_df = label_reviews_cli(sample_df)
    
    # Save progress
    labeled_df.to_csv('data/processed/labeled_reviews.csv', index=False)
    
    # Summary
    labeled_count = labeled_df['return_intent'].notna().sum()
    positive_count = (labeled_df['return_intent'] == 1).sum()
    print(f"\n{'='*80}")
    print(f"Labeling Progress:")
    print(f"  Total labeled: {labeled_count}/300")
    print(f"  Return intent (1): {positive_count}")
    print(f"  No return intent (0): {labeled_count - positive_count}")
    print(f"{'='*80}")
